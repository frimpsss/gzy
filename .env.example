# Copy to .env.local and fill in your GitHub OAuth App client ID.
# This is NOT a secret (device flow has no client_secret); .env.local
# is gitignored only to keep per-developer values out of the repo.
#
# Get one at https://github.com/settings/developers -> New OAuth App
# (enable "Device Flow" on the app's settings page).

GZY_GITHUB_CLIENT_ID=Iv1.replace-me
